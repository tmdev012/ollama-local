#!/bin/bash
# ai-code — Code-specific AI assistant (llama3.2 3B)
# Archived 2026-02-08, restored 2026-03-01

if [ -t 0 ]; then
    if [ $# -eq 0 ]; then
        echo "Usage: ai-code [PROMPT]"
        echo "   Or: command | ai-code"
        exit 1
    fi
    prompt="$*"
else
    prompt=$(cat -)
    if [ $# -gt 0 ]; then
        prompt="$prompt $*"
    fi
fi

echo "Code Assistant (llama3.2):"
echo ""
ollama run llama3.2 "$prompt"
