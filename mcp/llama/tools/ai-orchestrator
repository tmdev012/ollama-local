#!/bin/bash
# AI Orchestrator v3.1.0 - Context-aware entry point
# Reads .env, uses correct model, injects date, logs to history DB
# Integrates: kanban-pmo, persist-memory-probe, ollama-local (unified DB)
# Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>

VERSION="3.1.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SASHI_HOME="${SCRIPT_DIR%/mcp/llama/tools}"
source "$SASHI_HOME/.env" 2>/dev/null || true
source "$SASHI_HOME/lib/sh/banner.sh" 2>/dev/null || true

MODEL="${LOCAL_MODEL:-fast-sashi}"
DB_PATH="${SASHI_DB:-$SASHI_HOME/db/history.db}"
KANBAN_DIR="${KANBAN_DIR:-$HOME/kanban-pmo/kanban}"
PROBE_DIR="${PROBE_DIR:-$HOME/persist-memory-probe}"
TODAY=$(date +%Y-%m-%d)

# Colors
C='\033[0;36m'    # cyan
B='\033[0;34m'    # blue
G='\033[0;32m'    # green
Y='\033[1;33m'    # yellow
D='\033[0;90m'    # dim
W='\033[1;37m'    # white bold
N='\033[0m'       # reset

banner() {
    sashi_banner 2>/dev/null || true
}

show_help() {
    banner
    echo -e "  ${W}Usage:${N} ai-orchestrator [OPTION] [PROMPT]"
    echo ""
    echo -e "  ${G}Options:${N}"
    echo -e "    ${W}-i${N}, ${W}--interactive${N}   Start interactive chat"
    echo -e "    ${W}-s${N}, ${W}--status${N}        Show system status"
    echo -e "    ${W}-m${N}, ${W}--models${N}        List available models"
    echo -e "    ${W}-h${N}, ${W}--help${N}          Show this help"
    echo -e "    ${W}-v${N}, ${W}--version${N}       Show version"
    echo -e "    ${W}--model${N} <name>      Override model for this query"
    echo -e "    ${W}--write${N} <file>      Write llama output to file"
    echo -e "    ${W}--kanban${N}            Inject kanban state into prompt context"
    echo ""
    echo -e "  ${G}Examples:${N}"
    echo -e "    ${D}\$${N} ai-orchestrator 'Hello world'"
    echo -e "    ${D}\$${N} ai-orchestrator --interactive"
    echo -e "    ${D}\$${N} ai-orchestrator --model sashi-llama-8b 'detailed question'"
    echo -e "    ${D}\$${N} ai-orchestrator --write /tmp/out.txt 'explain bash arrays'"
    echo -e "    ${D}\$${N} ai-orchestrator --kanban 'what should I work on next?'"
    echo -e "    ${D}\$${N} echo 'text' | ai-orchestrator 'summarize this'"
    echo ""
    echo -e "  ${D}Repos: ollama-local · kanban-pmo · persist-memory-probe${N}"
    echo -e "  ${D}Auth:  SSH · PAT · GPG${N}"
}

show_status() {
    banner
    echo -e "  ${W}System${N}"
    echo -e "  ${D}├─${N} DB:        $DB_PATH"
    echo -e "  ${D}├─${N} Home:      $SASHI_HOME"
    echo -e "  ${D}├─${N} Kanban:    $KANBAN_DIR"
    echo -e "  ${D}└─${N} Probe:     $PROBE_DIR"
    echo ""

    if systemctl is-active ollama &>/dev/null; then
        echo -e "  ${G}●${N} Ollama running"
    else
        echo -e "  ${Y}●${N} Ollama stopped ${D}(ollama-up to start)${N}"
    fi
    echo ""

    echo -e "  ${W}Repos${N} ${D}(unified DB)${N}"
    python3 << PYEOF 2>/dev/null || echo -e "  ${D}(DB unavailable)${N}"
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
try:
    c.execute('SELECT name, auth_method, status FROM repo_registry')
    for r in c.fetchall():
        icon = '\033[0;32m●\033[0m' if r[2] == 'active' else '\033[1;33m●\033[0m'
        print(f"  {icon} {r[0]:<25} auth: {r[1]}")
except: pass
PYEOF

    echo ""
    echo -e "  ${W}Context${N}"
    python3 << PYEOF 2>/dev/null
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
try:
    c.execute('SELECT * FROM v_session_context')
    for r in c.fetchall():
        print(f"  \033[0;90m├─\033[0m {r[0]}: {r[1]}")
except: pass
PYEOF

    echo ""
    echo -e "  ${W}Models${N}"
    ollama list 2>/dev/null | sed 's/^/  /' || echo "  (none)"

    echo ""
    echo -e "  ${W}Recent Queries${N}"
    python3 << PYEOF 2>/dev/null || echo "  No history"
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
c.execute('SELECT timestamp, model, substr(prompt,1,50), duration_ms FROM queries ORDER BY id DESC LIMIT 5')
for r in c.fetchall():
    p = (r[2] or '')[:47]
    if len(r[2] or '') > 47: p += '...'
    print(f"  \033[0;90m│\033[0m {r[0]} \033[0;90m│\033[0m {r[1]:<14} \033[0;90m│\033[0m {p:<50} \033[0;90m│\033[0m {r[3] or 0}ms")
PYEOF
}

log_query() {
    local model="$1" prompt="$2" resp_len="$3" duration="$4"
    {
        python3 << PYEOF 2>/dev/null
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
c.execute('CREATE TABLE IF NOT EXISTS queries (id INTEGER PRIMARY KEY, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP, model TEXT, prompt TEXT, response_length INTEGER, duration_ms INTEGER)')
c.execute('INSERT INTO queries (model, prompt, response_length, duration_ms) VALUES (?, ?, ?, ?)',
          ('$model', '''${prompt//\'/\'\'}''', $resp_len, $duration))
conn.commit()
PYEOF
    } &
}

get_kanban_context() {
    local ctx=""
    for col in backlog open wip closed; do
        local count=$(ls "$KANBAN_DIR/$col/" 2>/dev/null | wc -l)
        ctx="$ctx [$col: $count]"
    done
    local db_ctx
    db_ctx=$(python3 << PYEOF 2>/dev/null
import sqlite3
conn = sqlite3.connect('$DB_PATH')
c = conn.cursor()
try:
    c.execute('SELECT status, card_count FROM v_kanban_summary')
    for r in c.fetchall():
        print(f"{r[0]}:{r[1]}", end=" ")
except: pass
PYEOF
    )
    [ -n "$db_ctx" ] && ctx="$ctx db:[$db_ctx]"
    echo "$ctx"
}

# Parse arguments
INTERACTIVE=false
WRITE_FILE=""
INJECT_KANBAN=false
PROMPT=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -i|--interactive) INTERACTIVE=true; shift ;;
        -s|--status) show_status; exit 0 ;;
        -m|--models) ollama list; exit 0 ;;
        -h|--help) show_help; exit 0 ;;
        -v|--version) echo "AI Orchestrator v$VERSION"; exit 0 ;;
        --model) MODEL="$2"; shift 2 ;;
        --write) WRITE_FILE="$2"; shift 2 ;;
        --kanban) INJECT_KANBAN=true; shift ;;
        *) PROMPT="$PROMPT $1"; shift ;;
    esac
done

if [ "$INTERACTIVE" = true ]; then
    banner
    echo -e "  ${D}Type /bye or Ctrl+D to exit${N}"
    echo ""
    ollama run "$MODEL"
    exit 0
fi

# Read stdin if piped
if [ ! -t 0 ]; then
    STDIN_INPUT=$(cat -)
    [ -n "$STDIN_INPUT" ] && PROMPT="$STDIN_INPUT $PROMPT"
fi

PROMPT=$(echo "$PROMPT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$PROMPT" ]; then
    show_help
    exit 1
fi

# Inject kanban context if requested
if [ "$INJECT_KANBAN" = true ]; then
    KANBAN_CTX=$(get_kanban_context)
    PROMPT="[Kanban state:$KANBAN_CTX] $PROMPT"
fi

# Inject date context
FULL_PROMPT="[Today: $TODAY] $PROMPT"

start_time=$(date +%s%3N)
response=$(ollama run "$MODEL" "$FULL_PROMPT" 2>/dev/null)
duration=$(( $(date +%s%3N) - start_time ))

echo "$response"

# Write to file if requested
if [ -n "$WRITE_FILE" ]; then
    echo "$response" > "$WRITE_FILE"
    echo ""
    echo -e "  ${G}✓${N} Written to ${W}$WRITE_FILE${N} ${D}(${#response} bytes)${N}"
fi

log_query "$MODEL" "$PROMPT" "${#response}" "$duration"
