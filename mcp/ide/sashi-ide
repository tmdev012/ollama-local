# ── State ─────────────────────────────────────────────────────────────────────
class IDEState:
    def __init__(self, project_root: Path):
        self.root        = project_root
        self.files       = []          # flat list of Path objects (visible in tree)
        self.file_idx    = 0           # selected file index
        self.open_file   = None        # currently viewed Path
        self.open_lines  = []          # lines of open file
        self.scroll      = 0           # code scroll offset
        self.build_log   = []          # build output lines
        self.adb_device  = None        # serial or None
        self.adb_status  = "scanning…"
        self.status_msg  = "Ready — press ? for help"
        self.mode        = "normal"    # normal | build | logcat | ai | diff
        self.spinner_on  = False
        self.spinner_txt = ""
        self.ai_resp     = ""
        self.lock        = threading.Lock()
        # inline input
        self.input_mode  = False       # True when footer prompt is active
        self.input_prompt= ""          # e.g. "AI question:" or "New class name:"
        self.input_buf   = ""          # current typed text
        self.input_cb    = None        # callable(text) when Enter pressed
        # diff state
        self.diff_lines  = []          # raw diff output lines

    def log(self, line: str):
        with self.lock:
            self.build_log.append(line)
            if len(self.build_log) > 500:
                self.build_log = self.build_log[-500:]

    def scan_files(self):
        exts = {".kt", ".java", ".xml", ".kts", ".toml", ".gradle", ".md", ".json", ".sh", ".py", ".yaml", ".yml", ".txt"}
        skip = {"build", ".gradle", ".idea", "__pycache__", "node_modules", ".git"}
        found = []
        for p in sorted(self.root.rglob("*")):
            if any(s in p.parts for s in skip): continue
            if p.is_file() and p.suffix in exts:
                found.append(p)
        self.files = found
        if found and self.open_file is None:
            self.open_file = found[0]
            self._load_file()

    def _load_file(self):
        try:
            self.open_lines = self.open_file.read_text(errors="replace").splitlines()
            self.scroll = 0
        except Exception as e:
            self.open_lines = [f"[error reading file: {e}]"]

    def select_file(self, idx: int):
        self.file_idx = max(0, min(idx, len(self.files) - 1))
        self.open_file = self.files[self.file_idx]
        self._load_file()

    def start_input(self, prompt: str, cb):
        """Enter inline input mode — footer shows a text prompt."""
        self.input_mode   = True
        self.input_prompt = prompt
        self.input_buf    = ""
        self.input_cb     = cb

    def finish_input(self, cancelled: bool = False):
        text = self.input_buf
        self.input_mode   = False
        self.input_prompt = ""
        self.input_buf    = ""
        cb = self.input_cb
        self.input_cb = None
        if not cancelled and cb and text.strip():
            cb(text.strip())

# ── ADB watcher ───────────────────────────────────────────────────────────────
def adb_watcher(state: IDEState, stop: threading.Event):
    while not stop.is_set():
        try:
            r = subprocess.run([ADB, "devices"], capture_output=True, text=True, timeout=3, env=IDE_ENV)
            lines = [l for l in r.stdout.splitlines()[1:] if l.strip() and "offline" not in l]
            devices = [l.split()[0] for l in lines if "\t" in l and "device" in l]
            with state.lock:
                if devices:
                    state.adb_device = devices[0]
                    state.adb_status = f"[green]● {devices[0]}[/green]"
                else:
                    state.adb_device = None
                    state.adb_status = "[yellow]○ no device[/yellow]"
        except Exception:
            with state.lock:
                state.adb_device = None
                state.adb_status = "[red]○ adb error[/red]"
        stop.wait(3)

# ── Build / run ───────────────────────────────────────────────────────────────
def run_cmd(state: IDEState, args: list, cwd: Path, label: str, done_cb=None):
    state.log(f"\n[bold cyan]▶ {label}[/bold cyan]")
    state.spinner_on  = True
    state.spinner_txt = label
    def _run():
        try:
            proc = subprocess.Popen(
                args, cwd=str(cwd), env=IDE_ENV,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
            )
            for line in proc.stdout:
                state.log(line.rstrip())
            proc.wait()
            ok = proc.returncode == 0
            state.log(f"[{'green' if ok else 'red'}]{'✓ SUCCESS' if ok else '✗ FAILED'} (exit {proc.returncode})[/{'green' if ok else 'red'}]")
            if done_cb: done_cb(ok)
        except Exception as e:
            state.log(f"[red]error: {e}[/red]")
            if done_cb: done_cb(False)
        finally:
            state.spinner_on  = False
            state.spinner_txt = ""
    threading.Thread(target=_run, daemon=True).start()

def do_build(state: IDEState):
    state.build_log.clear()
    state.mode = "build"
    run_cmd(state, ["./gradlew", "assembleDebug", "--quiet"], state.root, "gradle assembleDebug")

def do_test(state: IDEState):
    state.build_log.clear()
    state.mode = "build"
    run_cmd(state, ["./gradlew", "test", "--quiet"], state.root, "gradle test")

def do_run(state: IDEState):
    if not state.adb_device:
        state.log("[yellow]⚠ No ADB device — connect phone + enable USB debugging[/yellow]")
        state.log("[cyan]  Settings → Developer options → USB debugging → ON[/cyan]")
        state.log("[cyan]  Then plug in USB cable and press R again[/cyan]")
        state.mode = "build"
        return
    state.build_log.clear()
    state.mode = "build"
    apk = state.root / "app/build/outputs/apk/debug/app-debug.apk"
    pkg = _get_package(state)

    def after_build(ok: bool):
        if not ok: return
        state.log(f"\n[cyan]▶ adb install -r {apk.name}[/cyan]")
        run_cmd(state, [ADB, "install", "-r", str(apk)], state.root, "adb install",
                done_cb=lambda ok2: _launch(state, pkg) if ok2 else None)

    run_cmd(state, ["./gradlew", "assembleDebug", "--quiet"], state.root, "gradle assembleDebug",
            done_cb=after_build)

def _launch(state: IDEState, pkg: str):
    activity = f"{pkg}/.MainActivity"
    state.log(f"[cyan]▶ adb shell am start -n {activity}[/cyan]")
    run_cmd(state, [ADB, "shell", "am", "start", "-n", activity], state.root, "launch app")

def _get_package(state: IDEState) -> str:
    manifest = state.root / "app/src/main/AndroidManifest.xml"
    try:
        txt = manifest.read_text()
        import re
        m = re.search(r'package="([^"]+)"', txt)
        return m.group(1) if m else "com.sashi.hello"
    except Exception:
        return "com.sashi.hello"

def do_logcat(state: IDEState, stop_evt: threading.Event):
    if not state.adb_device:
        state.log("[yellow]No device for logcat[/yellow]"); return
    state.build_log.clear()
    state.mode = "logcat"
    pkg = _get_package(state)
    state.log(f"[cyan]▶ logcat — filtering {pkg}[/cyan]")
    def _stream():
        try:
            proc = subprocess.Popen(
                [ADB, "logcat", "--pid", _get_pid(pkg)],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, env=IDE_ENV
            )
            state._logcat_proc = proc
            for line in proc.stdout:
                if stop_evt.is_set(): break
                state.log(line.rstrip())
        except Exception as e:
            state.log(f"[red]logcat error: {e}[/red]")
    threading.Thread(target=_stream, daemon=True).start()

def _get_pid(pkg: str) -> str:
    try:
        r = subprocess.run([ADB, "shell", "pidof", pkg], capture_output=True, text=True, timeout=3, env=IDE_ENV)
        return r.stdout.strip().split()[0] if r.stdout.strip() else "0"
    except Exception:
        return "0"

def do_ai(state: IDEState, question: str = ""):
    state.mode = "build"
    ctx = ""
    if state.open_file:
        code = "\n".join(state.open_lines[:60])
        ctx = f"File: {state.open_file.name}\n```\n{code}\n```\n"
    prompt = f"{ctx}{question or 'Explain this code and suggest improvements.'}"
    state.log("[cyan]▶ Asking fast-sashi...[/cyan]")
    state.spinner_on  = True
    state.spinner_txt = "AI thinking..."
    def _ask():
        try:
            r = subprocess.run(
                ["ollama", "run", "fast-sashi", prompt],
                capture_output=True, text=True, timeout=120, env=IDE_ENV
            )
            for line in r.stdout.splitlines():
                state.log(line)
        except Exception as e:
            state.log(f"[red]AI error: {e}[/red]")
        finally:
            state.spinner_on  = False
            state.spinner_txt = ""
    threading.Thread(target=_ask, daemon=True).start()

def do_diff(state: IDEState):
    """Show git diff of the currently open file in the code panel."""
    if not state.open_file:
        state.status_msg = "No file open for diff"
        return
    try:
        r = subprocess.run(
            ["git", "diff", "--", str(state.open_file)],
            capture_output=True, text=True, cwd=str(state.root)
        )
        diff_out = r.stdout or "(no unstaged changes)"
        # Also check staged
        r2 = subprocess.run(
            ["git", "diff", "--cached", "--", str(state.open_file)],
            capture_output=True, text=True, cwd=str(state.root)
        )
        if r2.stdout:
            diff_out = r2.stdout + "\n" + diff_out
        state.diff_lines = diff_out.splitlines()
        state.mode = "diff"
        state.scroll = 0
        state.status_msg = f"Diff: {state.open_file.name}  (D again or Q to close)"
    except Exception as e:
        state.status_msg = f"git diff error: {e}"

def do_new_file(state: IDEState, rel_path: str, content: str):
    """Write a new file via sashi probe write (gRPC) or directly."""
    target = state.root / rel_path
    target.parent.mkdir(parents=True, exist_ok=True)
    try:
        r = subprocess.run(
            ["python3", "-c", f"""
import sys; sys.path.insert(0, '{Path.home()}/kanban-pmo/generated')
import grpc, kanban_pb2, kanban_pb2_grpc
ch = grpc.insecure_channel('localhost:50051')
stub = kanban_pb2_grpc.ProbeSyncStub(ch)
resp = stub.FsWrite(kanban_pb2.FsWriteRequest(
    target_path='{target}', content={repr(content)}), timeout=5)
print('grpc ok' if resp.ok else 'grpc fail')
"""],
            capture_output=True, text=True, timeout=10
        )
        via = "gRPC" if "ok" in r.stdout else "direct"
    except Exception:
        via = "direct"
    if via == "direct":
        target.write_text(content)
    state.log(f"[green]✓ Created {rel_path} via {via}[/green]")
    state.scan_files()

