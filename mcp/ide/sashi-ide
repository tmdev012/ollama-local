def render(state: IDEState, show_help: bool, term_h: int, term_w: int) -> Layout:
    layout = Layout()
    layout.split_column(
        Layout(name="header", size=3),
        Layout(name="main"),
        Layout(name="output", size=14),
        Layout(name="footer", size=3),
    )
    layout["main"].split_row(
        Layout(name="tree",  ratio=1),
        Layout(name="code",  ratio=3),
    )

    # ── Header ────────────────────────────────────────────────────────────────
    proj = state.root.name
    file_name = state.open_file.name if state.open_file else "—"
    spin = Spinner("dots").render(time.time()) if state.spinner_on else Text("")
    hdr = Table.grid(expand=True)
    hdr.add_column(justify="left")
    hdr.add_column(justify="center")
    hdr.add_column(justify="right")
    hdr.add_row(
        Text(f" ⚡ SASHI IDE v1.0  [{proj}]", style="bold green"),
        Text(f" {file_name}", style="cyan"),
        Text(f"ADB: {state.adb_status}  v3.2.0 ", style=""),
    )
    layout["header"].update(Panel(hdr, style="bold", box=box.HEAVY_HEAD))

    # ── File tree ─────────────────────────────────────────────────────────────
    tree_h = max(4, term_h - 20)
    tree_tbl = Table(show_header=False, box=None, padding=(0, 0), expand=True)
    tree_tbl.add_column()
    vis_start = max(0, state.file_idx - tree_h // 2)
    for i, f in enumerate(state.files[vis_start : vis_start + tree_h]):
        abs_i = vis_start + i
        rel   = str(f.relative_to(state.root))
        # indent depth
        depth = len(f.relative_to(state.root).parts) - 1
        pad   = "  " * depth
        sel   = abs_i == state.file_idx
        ext_color = {".kt": "bright_yellow", ".xml": "bright_blue",
                     ".kts": "orange1", ".md": "green", ".toml": "magenta"}.get(f.suffix, "white")
        txt = Text(f"{pad}{'▶ ' if sel else '  '}{f.name}", style=f"bold {ext_color}" if sel else ext_color)
        tree_tbl.add_row(txt)
    layout["tree"].update(Panel(tree_tbl, title="[bold]FILES[/bold]", border_style="blue"))

    # ── Code viewer ────────────────────────────────────────────────────────────
    if show_help:
        layout["code"].update(Panel(Text.from_markup(HELP), title="[bold]HELP[/bold]", border_style="cyan"))
    elif state.open_file:
        code_h   = max(4, term_h - 20)
        ext_map  = {".kt": "kotlin", ".java": "java", ".xml": "xml",
                    ".kts": "kotlin", ".toml": "toml", ".md": "markdown",
                    ".sh": "bash", ".py": "python", ".json": "json",
                    ".yaml": "yaml", ".yml": "yaml"}
        lang     = ext_map.get(state.open_file.suffix, "text")
        visible  = state.open_lines[state.scroll : state.scroll + code_h]
        code_txt = "\n".join(visible)
        syn      = Syntax(code_txt, lang, theme="monokai", line_numbers=True,
                          start_line=state.scroll + 1, word_wrap=False)
        total    = len(state.open_lines)
        pct      = int(100 * state.scroll / max(1, total - code_h))
        title    = f"[bold]{state.open_file.relative_to(state.root)}[/bold]  [dim]line {state.scroll+1}/{total} ({pct}%)[/dim]"
        layout["code"].update(Panel(syn, title=title, border_style="green"))
    else:
        layout["code"].update(Panel(Text("No file selected", style="dim"), border_style="green"))

    # ── Output / build log ────────────────────────────────────────────────────
    out_h = 11
    with state.lock:
        log_lines = state.build_log[-(out_h):]
    out_tbl = Table(show_header=False, box=None, padding=(0, 0), expand=True)
    out_tbl.add_column()
    for line in log_lines:
        out_tbl.add_row(Text.from_markup(line) if "[" in line else Text(line, style="dim"))
    mode_color = {"build": "yellow", "logcat": "cyan", "normal": "dim"}.get(state.mode, "dim")
    spin_txt   = f"  {state.spinner_txt}" if state.spinner_on else ""
    out_title  = f"[bold {mode_color}]{state.mode.upper()}[/bold {mode_color}]{spin_txt}"
    layout["output"].update(Panel(out_tbl, title=out_title, border_style=mode_color))

    # ── Footer ────────────────────────────────────────────────────────────────
    keys = "[B]uild  [R]un→phone  [L]ogcat  [K]ill  [A]I  [E]dit  [N]ew  [?]help  [Q]uit"
    ftr  = Table.grid(expand=True)
    ftr.add_column(justify="left")
    ftr.add_column(justify="right")
    ftr.add_row(Text(f" {keys}", style="dim"), Text(f" {state.status_msg}", style="italic cyan"))
    layout["footer"].update(Panel(ftr, box=box.SIMPLE))

    return layout

# ── Input ─────────────────────────────────────────────────────────────────────
def getch():
    fd   = sys.stdin.fileno()
    old  = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            ch += sys.stdin.read(2)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    return ch

# ── Main ──────────────────────────────────────────────────────────────────────
def main():
    import argparse, shutil
    ap = argparse.ArgumentParser(description="SASHI IDE — Terminal Android/Kotlin IDE")
    ap.add_argument("project", nargs="?", default=str(Path.home() / "projects/hello-android"),
                    help="Path to Android/Kotlin project (default: ~/projects/hello-android)")
    args = ap.parse_args()

    root = Path(args.project).expanduser().resolve()
    if not root.exists():
        console.print(f"[red]Project not found: {root}[/red]"); sys.exit(1)

    state = IDEState(root)
    state.scan_files()
    state.log(f"[bold green]SASHI IDE v1.0[/bold green]  [{root.name}]")
    state.log(f"  JAVA_HOME: {JAVA_HOME}")
    state.log(f"  ADB:       {ADB}")
    state.log(f"  Project:   {root}")
    state.log("")
    state.log("[dim]Press B to build, R to run on phone, ? for full help[/dim]")

    stop_evt  = threading.Event()
    logcat_stop = threading.Event()
    show_help = False

    # Start ADB watcher
    threading.Thread(target=adb_watcher, args=(state, stop_evt), daemon=True).start()

    term_w, term_h = shutil.get_terminal_size((120, 40))

    try:
        with Live(render(state, show_help, term_h, term_w),
                  console=console, refresh_per_second=4, screen=True) as live:
            while True:
                term_w, term_h = shutil.get_terminal_size((120, 40))
                live.update(render(state, show_help, term_h, term_w))
                time.sleep(0.05)

                # Non-blocking key check
                import select
                if select.select([sys.stdin], [], [], 0.2)[0]:
                    ch = getch()
                else:
                    continue

                # Navigation
                if ch in ("j", "\x1b[B"):   # down
                    state.select_file(state.file_idx + 1)
                    state.status_msg = f"{state.open_file.name}"
                elif ch in ("k", "\x1b[A"): # up
                    state.select_file(state.file_idx - 1)
                    state.status_msg = f"{state.open_file.name}"
                elif ch in ("\r", "\n"):     # enter — already selected on j/k
                    state.status_msg = f"Opened {state.open_file.name}"

                # Code scroll
                elif ch in ("f", "\x1b[6~"):  # pgdn
                    state.scroll = min(state.scroll + 20, max(0, len(state.open_lines) - 5))
                elif ch in ("b", "\x1b[5~"):  # pgup
                    state.scroll = max(0, state.scroll - 20)
                elif ch == "\x1b[B" and state.mode == "code":
                    state.scroll = min(state.scroll + 3, max(0, len(state.open_lines) - 5))
                elif ch == "\x1b[A" and state.mode == "code":
                    state.scroll = max(0, state.scroll - 3)

                # Build
                elif ch in ("B",):
                    state.status_msg = "Building APK..."
                    do_build(state)

                # Run on phone
                elif ch in ("R",):
                    if not state.adb_device:
                        state.status_msg = "⚠ Connect phone — USB debugging ON"
                    else:
                        state.status_msg = f"Deploying to {state.adb_device}..."
                    do_run(state)

                # Logcat
                elif ch in ("L",):
                    if state.adb_device:
                        logcat_stop.clear()
                        do_logcat(state, logcat_stop)
                        state.status_msg = "Streaming logcat — K to stop"
                    else:
                        state.status_msg = "No device for logcat"

                # Kill / stop
                elif ch in ("K",):
                    logcat_stop.set()
                    if hasattr(state, "_logcat_proc"):
                        try: state._logcat_proc.terminate()
                        except Exception: pass
                    state.mode   = "normal"
                    state.status_msg = "Stopped"

                # AI assist
                elif ch in ("A",):
                    state.status_msg = "AI thinking..."
                    do_ai(state)

                # Open in editor
                elif ch in ("E",):
                    if state.open_file:
                        editor = os.environ.get("EDITOR", "nano")
                        live.stop()
                        subprocess.run([editor, str(state.open_file)])
                        state._load_file()
                        live.start()

                # New file scaffold
                elif ch in ("N",):
                    state.status_msg = "Scaffold: creating new Kotlin activity..."
                    _scaffold_new_activity(state)

                # Help
                elif ch in ("?",):
                    show_help = not show_help

                # Quit
                elif ch in ("q", "Q", "\x03"):
                    break

    except KeyboardInterrupt:
        pass
    finally:
        stop_evt.set()
        logcat_stop.set()
        console.print("[bold green]SASHI IDE closed.[/bold green]")


def _scaffold_new_activity(state: IDEState):
    """Generate a new Kotlin activity using fast-sashi then write via gRPC."""
    pkg = _get_package(state)
    name = "SecondActivity"
    content = f"""package {pkg}

import android.os.Bundle
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity

class {name} : AppCompatActivity() {{
    override fun onCreate(savedInstanceState: Bundle?) {{
        super.onCreate(savedInstanceState)
        val tv = TextView(this).apply {{
            text = "Hello from {name}\\n\\nGenerated by SASHI IDE + fast-sashi"
            textSize = 18f
            setPadding(64, 120, 64, 0)
        }}
        setContentView(tv)
    }}
}}
"""
    rel = f"app/src/main/kotlin/{pkg.replace('.', '/')}/{name}.kt"
    state.log(f"[cyan]▶ Scaffolding {name}.kt via gRPC probe write...[/cyan]")
    threading.Thread(
        target=do_new_file, args=(state, rel, content), daemon=True
    ).start()


if __name__ == "__main__":
    main()
