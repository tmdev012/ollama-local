def render(state: IDEState, show_help: bool, term_h: int, term_w: int) -> Layout:
    layout = Layout()
    layout.split_column(
        Layout(name="header", size=3),
        Layout(name="main"),
        Layout(name="output", size=14),
        Layout(name="footer", size=3),
    )
    layout["main"].split_row(
        Layout(name="tree",  ratio=1),
        Layout(name="code",  ratio=3),
    )

    # ── Header ────────────────────────────────────────────────────────────────
    proj = state.root.name
    file_name = state.open_file.name if state.open_file else "—"
    hdr = Table.grid(expand=True)
    hdr.add_column(justify="left")
    hdr.add_column(justify="center")
    hdr.add_column(justify="right")
    hdr.add_row(
        Text(f" ⚡ Sashi Android Studio  [{proj}]", style="bold green"),
        Text(f" {file_name}", style="cyan"),
        Text.from_markup(f"ADB: {state.adb_status}  v1.2 "),
    )
    layout["header"].update(Panel(hdr, style="bold", box=box.HEAVY_HEAD))

    # ── File tree ─────────────────────────────────────────────────────────────
    tree_h = max(4, term_h - 20)
    tree_tbl = Table(show_header=False, box=None, padding=(0, 0), expand=True)
    tree_tbl.add_column()
    vis_start = max(0, state.file_idx - tree_h // 2)
    for i, f in enumerate(state.files[vis_start : vis_start + tree_h]):
        abs_i = vis_start + i
        rel   = str(f.relative_to(state.root))
        depth = len(f.relative_to(state.root).parts) - 1
        pad   = "  " * depth
        sel   = abs_i == state.file_idx
        ext_color = {".kt": "bright_yellow", ".xml": "bright_blue",
                     ".kts": "orange1", ".md": "green", ".toml": "magenta"}.get(f.suffix, "white")
        txt = Text(f"{pad}{'▶ ' if sel else '  '}{f.name}", style=f"bold {ext_color}" if sel else ext_color)
        tree_tbl.add_row(txt)
    layout["tree"].update(Panel(tree_tbl, title="[bold]FILES[/bold]", border_style="blue"))

    # ── Code viewer ────────────────────────────────────────────────────────────
    if show_help:
        layout["code"].update(Panel(Text.from_markup(HELP), title="[bold]HELP[/bold]", border_style="cyan"))
    elif state.mode == "diff" and state.diff_lines:
        code_h  = max(4, term_h - 20)
        visible = state.diff_lines[state.scroll : state.scroll + code_h]
        syn     = Syntax("\n".join(visible), "diff", theme="monokai", line_numbers=True,
                         start_line=state.scroll + 1, word_wrap=False)
        total   = len(state.diff_lines)
        pct     = int(100 * state.scroll / max(1, total - code_h))
        title   = f"[bold]DIFF  {state.open_file.relative_to(state.root) if state.open_file else ''}[/bold]  [dim]line {state.scroll+1}/{total} ({pct}%)[/dim]"
        layout["code"].update(Panel(syn, title=title, border_style="magenta"))
    elif state.open_file:
        code_h   = max(4, term_h - 20)
        ext_map  = {".kt": "kotlin", ".java": "java", ".xml": "xml",
                    ".kts": "kotlin", ".toml": "toml", ".md": "markdown",
                    ".sh": "bash", ".py": "python", ".json": "json",
                    ".yaml": "yaml", ".yml": "yaml"}
        lang     = ext_map.get(state.open_file.suffix, "text")
        visible  = state.open_lines[state.scroll : state.scroll + code_h]
        code_txt = "\n".join(visible)
        syn      = Syntax(code_txt, lang, theme="monokai", line_numbers=True,
                          start_line=state.scroll + 1, word_wrap=False)
        total    = len(state.open_lines)
        pct      = int(100 * state.scroll / max(1, total - code_h))
        title    = f"[bold]{state.open_file.relative_to(state.root)}[/bold]  [dim]line {state.scroll+1}/{total} ({pct}%)[/dim]"
        layout["code"].update(Panel(syn, title=title, border_style="green"))
    else:
        layout["code"].update(Panel(Text("No file selected", style="dim"), border_style="green"))

    # ── Output / build log ────────────────────────────────────────────────────
    out_h = 11
    with state.lock:
        log_lines = state.build_log[-(out_h):]
    out_tbl = Table(show_header=False, box=None, padding=(0, 0), expand=True)
    out_tbl.add_column()
    for line in log_lines:
        out_tbl.add_row(Text.from_markup(line) if "[" in line else Text(line, style="dim"))
    mode_color = {"build": "yellow", "logcat": "cyan", "diff": "magenta", "normal": "dim"}.get(state.mode, "dim")
    spin_txt   = f"  {state.spinner_txt}" if state.spinner_on else ""
    out_title  = f"[bold {mode_color}]{state.mode.upper()}[/bold {mode_color}]{spin_txt}"
    layout["output"].update(Panel(out_tbl, title=out_title, border_style=mode_color))

    # ── Footer ────────────────────────────────────────────────────────────────
    if state.input_mode:
        # Inline input prompt
        prompt_txt = Text(f" {state.input_prompt}  ", style="bold yellow")
        input_txt  = Text(state.input_buf + "█", style="bold white")
        ftr = Table.grid(expand=True)
        ftr.add_column(justify="left")
        ftr.add_column(justify="right")
        ftr.add_row(
            Text.assemble(prompt_txt, input_txt),
            Text(" ESC to cancel  Enter to confirm", style="dim"),
        )
        layout["footer"].update(Panel(ftr, box=box.SIMPLE, border_style="yellow"))
    else:
        keys = "[B]uild  [R]un  [T]est  [L]ogcat  [K]ill  [C]lear  [A]I  [/]ask  [D]iff  [E]dit  [N]ew  [?]help  [Q]uit"
        ftr  = Table.grid(expand=True)
        ftr.add_column(justify="left")
        ftr.add_column(justify="right")
        ftr.add_row(Text(f" {keys}", style="dim"), Text(f" {state.status_msg}", style="italic cyan"))
        layout["footer"].update(Panel(ftr, box=box.SIMPLE))

    return layout

# ── Input ─────────────────────────────────────────────────────────────────────
def getch():
    fd  = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = os.read(fd, 1).decode("utf-8", errors="replace")
        if ch == "\x1b":
            import select as _sel
            if _sel.select([sys.stdin], [], [], 0.05)[0]:
                ch2 = os.read(fd, 1).decode("utf-8", errors="replace")
                ch += ch2
                if ch2 == "[":
                    ch3 = os.read(fd, 1).decode("utf-8", errors="replace")
                    ch += ch3
                    # 4-byte sequences like \x1b[5~ (PgUp) and \x1b[6~ (PgDn)
                    if ch3.isdigit() and _sel.select([sys.stdin], [], [], 0.05)[0]:
                        ch += os.read(fd, 1).decode("utf-8", errors="replace")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    return ch

# ── Main ──────────────────────────────────────────────────────────────────────
def main():
    import argparse, shutil
    ap = argparse.ArgumentParser(description="Sashi Android Studio — Terminal Android/Kotlin IDE")
    ap.add_argument("project", nargs="?", default=str(Path.home() / "projects/hello-android"),
                    help="Path to Android/Kotlin project (default: ~/projects/hello-android)")
    args = ap.parse_args()

    root = Path(args.project).expanduser().resolve()
    if not root.exists():
        console.print(f"[red]Project not found: {root}[/red]"); sys.exit(1)

    state = IDEState(root)
    state.scan_files()
    state.log(f"[bold green]Sashi Android Studio v1.2[/bold green]  [{root.name}]")
    state.log(f"  JAVA_HOME: {JAVA_HOME}")
    state.log(f"  ADB:       {ADB}")
    state.log(f"  Project:   {root}")
    state.log("")
    state.log("[dim]Press B to build, R to run on phone, ? for full help[/dim]")

    stop_evt    = threading.Event()
    logcat_stop = threading.Event()
    show_help   = False

    threading.Thread(target=adb_watcher, args=(state, stop_evt), daemon=True).start()

    term_w, term_h = shutil.get_terminal_size((120, 40))

    try:
        with Live(render(state, show_help, term_h, term_w),
                  console=console, refresh_per_second=4, screen=True) as live:
            while True:
                term_w, term_h = shutil.get_terminal_size((120, 40))
                live.update(render(state, show_help, term_h, term_w))
                time.sleep(0.05)

                import select
                if select.select([sys.stdin], [], [], 0.2)[0]:
                    ch = getch()
                else:
                    continue

                # ── Inline input mode ──────────────────────────────────────────
                if state.input_mode:
                    if ch in ("\r", "\n"):
                        state.finish_input(cancelled=False)
                    elif ch == "\x1b":          # ESC — bare (no trailing chars)
                        state.finish_input(cancelled=True)
                        state.status_msg = "Cancelled"
                    elif ch in ("\x7f", "\x08"): # backspace
                        state.input_buf = state.input_buf[:-1]
                    elif len(ch) == 1 and ch.isprintable():
                        state.input_buf += ch
                    continue

                # ── Normal mode keybindings ────────────────────────────────────

                # Navigation — file tree
                if ch in ("j", "\x1b[B"):      # down
                    state.select_file(state.file_idx + 1)
                    state.status_msg = f"{state.open_file.name}"
                    if state.mode == "diff": state.mode = "normal"
                elif ch in ("k", "\x1b[A"):    # up
                    state.select_file(state.file_idx - 1)
                    state.status_msg = f"{state.open_file.name}"
                    if state.mode == "diff": state.mode = "normal"
                elif ch in ("\r", "\n"):
                    state.status_msg = f"Opened {state.open_file.name}"

                # Jump top / bottom of file
                elif ch == "g":
                    state.scroll = 0
                    state.status_msg = "Top of file"
                elif ch == "G":
                    state.scroll = max(0, len(state.open_lines) - 5)
                    state.status_msg = "Bottom of file"

                # Code scroll
                elif ch in ("f", "\x1b[6~"):   # pgdn
                    src = state.diff_lines if state.mode == "diff" else state.open_lines
                    state.scroll = min(state.scroll + 20, max(0, len(src) - 5))
                elif ch in ("b", "\x1b[5~"):   # pgup
                    state.scroll = max(0, state.scroll - 20)

                # Build
                elif ch == "B":
                    state.status_msg = "Building APK..."
                    do_build(state)

                # Tests
                elif ch == "T":
                    state.status_msg = "Running tests..."
                    do_test(state)

                # Run on phone
                elif ch == "R":
                    if not state.adb_device:
                        state.status_msg = "⚠ Connect phone — USB debugging ON"
                    else:
                        state.status_msg = f"Deploying to {state.adb_device}..."
                    do_run(state)

                # Logcat
                elif ch == "L":
                    if state.adb_device:
                        logcat_stop.clear()
                        do_logcat(state, logcat_stop)
                        state.status_msg = "Streaming logcat — K to stop"
                    else:
                        state.status_msg = "No device for logcat"

                # Kill / stop
                elif ch == "K":
                    logcat_stop.set()
                    if hasattr(state, "_logcat_proc"):
                        try: state._logcat_proc.terminate()
                        except Exception: pass
                    state.mode   = "normal"
                    state.status_msg = "Stopped"

                # Clear log
                elif ch == "C":
                    with state.lock:
                        state.build_log.clear()
                    state.status_msg = "Log cleared"

                # AI assist — auto prompt
                elif ch == "A":
                    state.status_msg = "AI thinking..."
                    do_ai(state)

                # AI assist — custom question
                elif ch == "/":
                    fname = state.open_file.name if state.open_file else "file"
                    state.start_input(
                        f"AI question about {fname}:",
                        lambda q: do_ai(state, question=q),
                    )
                    state.status_msg = "Type question, Enter to send, ESC to cancel"

                # Git diff
                elif ch == "D":
                    if state.mode == "diff":
                        state.mode = "normal"
                        state.status_msg = "Diff closed"
                    else:
                        do_diff(state)

                # Open in editor
                elif ch == "E":
                    if state.open_file:
                        editor = os.environ.get("EDITOR", "nano")
                        live.stop()
                        subprocess.run([editor, str(state.open_file)])
                        state._load_file()
                        live.start()

                # New file scaffold — interactive
                elif ch == "N":
                    state.start_input(
                        "New Kotlin class name:",
                        lambda name: _scaffold_new_activity(state, name),
                    )
                    state.status_msg = "Enter class name, Enter to scaffold, ESC to cancel"

                # Help
                elif ch == "?":
                    show_help = not show_help

                # Quit
                elif ch in ("q", "Q", "\x03"):
                    break

    except KeyboardInterrupt:
        pass
    finally:
        stop_evt.set()
        logcat_stop.set()
        console.print("[bold green]SASHI IDE closed.[/bold green]")


def _scaffold_new_activity(state: IDEState, name: str = "SecondActivity"):
    """Generate a new Kotlin activity then write via gRPC or directly."""
    # Sanitize: class names must start with uppercase letter
    name = name.strip()
    if not name:
        name = "NewActivity"
    if not name[0].isupper():
        name = name[0].upper() + name[1:]
    # Strip .kt suffix if user typed it
    if name.endswith(".kt"):
        name = name[:-3]

    pkg = _get_package(state)
    content = f"""package {pkg}

import android.os.Bundle
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity

class {name} : AppCompatActivity() {{
    override fun onCreate(savedInstanceState: Bundle?) {{
        super.onCreate(savedInstanceState)
        val tv = TextView(this).apply {{
            text = "Hello from {name}\\n\\nGenerated by SASHI IDE v1.1"
            textSize = 18f
            setPadding(64, 120, 64, 0)
        }}
        setContentView(tv)
    }}
}}
"""
    rel = f"app/src/main/kotlin/{pkg.replace('.', '/')}/{name}.kt"
    state.log(f"[cyan]▶ Scaffolding {name}.kt...[/cyan]")
    state.mode = "build"
    threading.Thread(
        target=do_new_file, args=(state, rel, content), daemon=True
    ).start()


