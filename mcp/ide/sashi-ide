console = Console()

class FW(str, Enum):
    KOTLIN  = "kotlin"
    FLUTTER = "flutter"
    RN      = "typescript"
    UNKNOWN = "unknown"

# ── Framework detection ───────────────────────────────────────────────────────
def detect_framework(root: Path) -> FW:
    if (root / "pubspec.yaml").exists():
        return FW.FLUTTER
    if (root / "package.json").exists():
        try:
            pkg = json.loads((root / "package.json").read_text())
            deps = {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
            if "react-native" in deps or "expo" in deps:
                return FW.RN
        except Exception:
            pass
    if (root / "gradlew").exists() or (root / "build.gradle").exists() or \
       (root / "build.gradle.kts").exists():
        return FW.KOTLIN
    return FW.UNKNOWN

# ── ADB helper ────────────────────────────────────────────────────────────────
def adb_cmd() -> str | None:
    found = shutil.which("adb")
    if found:
        return found
    for c in [
        Path.home() / "Android/platform-tools/adb",
        Path("/usr/lib/android-sdk/platform-tools/adb"),
        Path("/opt/android-sdk/platform-tools/adb"),
    ]:
        if c.exists():
            return str(c)
    return None

def adb_devices(adb: str) -> list[str]:
    r = subprocess.run([adb, "devices"], capture_output=True, text=True)
    return [l.split()[0] for l in r.stdout.splitlines()[1:]
            if l.strip() and "device" in l and "offline" not in l]

# ── Package / manifest helpers ────────────────────────────────────────────────
def get_package(root: Path) -> str:
    manifest = root / "app/src/main/AndroidManifest.xml"
    try:
        m = re.search(r'package="([^"]+)"', manifest.read_text())
        return m.group(1) if m else "com.example.app"
    except Exception:
        return "com.example.app"

# ── Subprocess runner (streaming) ─────────────────────────────────────────────
def run(args, cwd=None, label="", env=None) -> bool:
    if label:
        console.print(f"[cyan]▶ {label}[/cyan]")
    merged_env = {**os.environ, **(env or {})}
    proc = subprocess.Popen(
        args, cwd=str(cwd) if cwd else None,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, env=merged_env,
    )
    for line in proc.stdout:
        console.print(line.rstrip())
    proc.wait()
    ok = proc.returncode == 0
    color = "green" if ok else "red"
    mark  = "✓ done" if ok else "✗ failed"
    console.print(f"[{color}]{mark} (exit {proc.returncode})[/{color}]")
    return ok

# ── File browser ──────────────────────────────────────────────────────────────
SKIP_DIRS = {"build", ".gradle", ".idea", "__pycache__", "node_modules",
             ".git", ".dart_tool", ".flutter-plugins"}
SHOW_EXTS = {".kt",".java",".xml",".kts",".toml",".gradle",".md",".json",
             ".sh",".py",".yaml",".yml",".txt",".dart",".ts",".tsx",".js",
             ".jsx",".swift",".html",".css"}

def scan_files(root: Path) -> list[Path]:
    files = []
    for p in sorted(root.rglob("*")):
        if any(s in p.parts for s in SKIP_DIRS):
            continue
        if p.is_file() and p.suffix in SHOW_EXTS:
            files.append(p)
    return files

def show_files(root: Path, files: list[Path]):
    tbl = Table(show_header=False, box=box.SIMPLE, padding=(0, 1))
    tbl.add_column("n", style="dim", width=4)
    tbl.add_column("file")
    color_map = {
        ".kt": "bright_yellow", ".dart": "cyan", ".ts": "bright_blue",
        ".tsx": "blue", ".xml": "bright_blue", ".kts": "orange1",
        ".md": "green", ".toml": "magenta", ".json": "dim",
    }
    for i, f in enumerate(files, 1):
        rel   = f.relative_to(root)
        depth = len(rel.parts) - 1
        pad   = "  " * depth
        c     = color_map.get(f.suffix, "white")
        tbl.add_row(str(i), Text(f"{pad}{f.name}", style=c))
    console.print(Panel(tbl, title=f"[bold]FILES — {root.name}[/bold]",
                        border_style="blue"))

def view_file(f: Path, root: Path):
    ext_map = {
        ".kt": "kotlin", ".java": "java", ".xml": "xml", ".kts": "kotlin",
        ".dart": "dart", ".ts": "typescript", ".tsx": "typescript",
        ".js": "javascript", ".jsx": "javascript", ".toml": "toml",
        ".md": "markdown", ".sh": "bash", ".py": "python",
        ".json": "json", ".yaml": "yaml", ".yml": "yaml",
    }
    lang = ext_map.get(f.suffix, "text")
    try:
        syn = Syntax(f.read_text(errors="replace"), lang, theme="monokai",
                     line_numbers=True, word_wrap=False)
        console.print(Panel(syn, title=f"[bold]{f.relative_to(root)}[/bold]",
                            border_style="green"))
    except Exception as e:
        console.print(f"[red]Cannot read file: {e}[/red]")

# ── Build ─────────────────────────────────────────────────────────────────────
def do_build(root: Path, fw: FW) -> bool:
    if fw == FW.FLUTTER:
        return run(["flutter", "build", "apk", "--debug"], cwd=root,
                   label="flutter build apk --debug")
    if fw == FW.RN:
        mgr = "yarn" if (root / "yarn.lock").exists() else "npx"
        if mgr == "yarn":
            return run(["yarn", "android", "--mode", "debug"], cwd=root,
                       label="yarn android")
        return run(["npx", "react-native", "build-android",
                    "--mode", "debug"], cwd=root,
                   label="npx react-native build-android")
    # Kotlin / Gradle (default)
    gradlew = root / "gradlew"
    cmd = [str(gradlew) if gradlew.exists() else "gradle",
           "assembleDebug", "--quiet"]
    return run(cmd, cwd=root, label="gradle assembleDebug")

# ── Test ──────────────────────────────────────────────────────────────────────
def do_test(root: Path, fw: FW) -> bool:
    if fw == FW.FLUTTER:
        return run(["flutter", "test"], cwd=root, label="flutter test")
    if fw == FW.RN:
        mgr = "yarn" if (root / "yarn.lock").exists() else "npm"
        return run([mgr, "test", "--watchAll=false"], cwd=root,
                   label=f"{mgr} test")
    gradlew = root / "gradlew"
    cmd = [str(gradlew) if gradlew.exists() else "gradle", "test", "--quiet"]
    return run(cmd, cwd=root, label="gradle test")

# ── Deploy ────────────────────────────────────────────────────────────────────
def do_deploy(root: Path, fw: FW, target: str = "usb") -> bool:
    """
    target: "usb"  → deploy via USB ADB
            "wifi" → prompt for IP (interactive only — pass wifi:<ip> for headless)
            "wifi:<ip>[:<port>]" → WiFi headless deploy
    """
    adb = adb_cmd()

    if fw == FW.FLUTTER:
        if not shutil.which("flutter"):
            console.print("[red]flutter not in PATH[/red]"); return False
        cmd = ["flutter", "install", "--debug"]
        if target.startswith("wifi:"):
            parts = target.split(":")
            ip    = parts[1]
            port  = parts[2] if len(parts) > 2 else "5555"
            if adb:
                subprocess.run([adb, "connect", f"{ip}:{port}"],
                               capture_output=True)
        return run(cmd, cwd=root, label="flutter install")

    if fw == FW.RN:
        mgr = "yarn" if (root / "yarn.lock").exists() else "npx"
        if mgr == "yarn":
            return run(["yarn", "android"], cwd=root, label="yarn android")
        return run(["npx", "react-native", "run-android"], cwd=root,
                   label="npx react-native run-android")

    # Kotlin / Gradle
    if not adb:
        console.print("[red]adb not found. Install: sudo apt install adb[/red]")
        console.print("[dim]Or: ~/Android/platform-tools/adb[/dim]")
        return False

    if target.startswith("wifi:"):
        parts = target.split(":")
        ip    = parts[1]
        port  = parts[2] if len(parts) > 2 else "5555"
        r = subprocess.run([adb, "connect", f"{ip}:{port}"],
                           capture_output=True, text=True)
        console.print(r.stdout.strip() or r.stderr.strip())
    elif target == "wifi":
        console.print("[yellow]Tip: pass wifi:<ip> for headless mode[/yellow]")
        ip = input("Phone IP: ").strip()
        if not ip:
            console.print("[red]No IP[/red]"); return False
        r = subprocess.run([adb, "connect", f"{ip}:5555"],
                           capture_output=True, text=True)
        console.print(r.stdout.strip() or r.stderr.strip())

    devs = adb_devices(adb)
    if not devs:
        console.print("[red]No device connected via ADB.[/red]")
        console.print("[dim]USB: enable USB debugging on phone[/dim]")
        console.print("[dim]WiFi: sashi adb wireless → then sashi android-studio --deploy wifi:<ip>[/dim]")
        return False
    console.print(f"[green]● Device: {devs[0]}[/green]")

    apk = root / "app/build/outputs/apk/debug/app-debug.apk"
    if not apk.exists():
        console.print("[yellow]APK not found — building first...[/yellow]")
        if not do_build(root, fw):
            return False

    pkg      = get_package(root)
    if not run([adb, "install", "-r", str(apk)], label="adb install"):
        return False
    activity = f"{pkg}/.MainActivity"
    return run([adb, "shell", "am", "start", "-n", activity],
               label=f"launch {pkg}")

# ── Env var management ────────────────────────────────────────────────────────
ENV_FILE = Path.home() / "ollama-local/.env"

def env_list():
    if not ENV_FILE.exists():
        console.print(f"[dim]No .env at {ENV_FILE}[/dim]"); return
    for line in ENV_FILE.read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            console.print(f"  [cyan]{line}[/cyan]")

def env_set(key: str, value: str):
    lines = ENV_FILE.read_text().splitlines() if ENV_FILE.exists() else []
    found = False
    for i, line in enumerate(lines):
        if re.match(rf"^{re.escape(key)}=", line):
            lines[i] = f"{key}={value}"
            found = True
            break
    if not found:
        lines.append(f"{key}={value}")
    ENV_FILE.write_text("\n".join(lines) + "\n")
    console.print(f"[green]✓ {key}={value} saved to {ENV_FILE}[/green]")

def env_get(key: str):
    if not ENV_FILE.exists():
        console.print("[red]No .env found[/red]"); return
    for line in ENV_FILE.read_text().splitlines():
        m = re.match(rf"^{re.escape(key)}=(.*)", line)
        if m:
            console.print(f"{key}={m.group(1)}"); return
    console.print(f"[yellow]{key} not set[/yellow]")

# ── AI assist ─────────────────────────────────────────────────────────────────
def do_ai(open_file: Path = None, question: str = ""):
    ctx = ""
    if open_file:
        try:
            lines = open_file.read_text(errors="replace").splitlines()[:60]
            ctx = f"File: {open_file.name}\n```\n" + "\n".join(lines) + "\n```\n"
        except Exception:
            pass
    if not question:
        question = input("AI question (Enter = auto-explain): ").strip()
    prompt = ctx + (question or "Explain this code and suggest improvements.")
    console.print("[cyan]▶ Asking fast-sashi...[/cyan]")
    r = subprocess.run(["ollama", "run", "fast-sashi", prompt],
                       capture_output=True, text=True, timeout=120)
    for line in (r.stdout or r.stderr).splitlines():
        console.print(line)

# ── Git diff ──────────────────────────────────────────────────────────────────
def do_diff(root: Path, open_file: Path = None):
    target = ["--", str(open_file)] if open_file else []
    r  = subprocess.run(["git", "diff"]             + target,
                        capture_output=True, text=True, cwd=str(root))
    r2 = subprocess.run(["git", "diff", "--cached"] + target,
                        capture_output=True, text=True, cwd=str(root))
    diff  = (r2.stdout + r.stdout).strip() or "(no changes)"
    fname = open_file.name if open_file else "project"
    console.print(Panel(Syntax(diff, "diff", theme="monokai", line_numbers=True),
                        title=f"[bold]DIFF — {fname}[/bold]",
                        border_style="magenta"))

