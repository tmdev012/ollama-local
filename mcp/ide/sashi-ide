# ── New Kotlin file ────────────────────────────────────────────────────────────
def do_new_file(root: Path):
    name = input("New Kotlin class name: ").strip()
    if not name: return
    if not name[0].isupper(): name = name[0].upper() + name[1:]
    if name.endswith(".kt"): name = name[:-3]
    pkg = get_package(root)
    content = f"""package {pkg}

import android.os.Bundle
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity

class {name} : AppCompatActivity() {{
    override fun onCreate(savedInstanceState: Bundle?) {{
        super.onCreate(savedInstanceState)
        val tv = TextView(this).apply {{
            text = "Hello from {name}\\n\\nGenerated by Sashi Android Studio v2.0"
            textSize = 18f
            setPadding(64, 120, 64, 0)
        }}
        setContentView(tv)
    }}
}}
"""
    rel = f"app/src/main/kotlin/{pkg.replace('.', '/')}/{name}.kt"
    target = root / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content)
    console.print(f"[green]✓ Created {rel}[/green]")

# ── Main menu ─────────────────────────────────────────────────────────────────
def main():
    import argparse
    ap = argparse.ArgumentParser(description="Sashi Android Studio — Terminal Android/Kotlin IDE")
    ap.add_argument("project", nargs="?", default=str(Path.home() / "projects/hello-android"))
    args = ap.parse_args()

    root = Path(args.project).expanduser().resolve()
    if not root.exists():
        scaffold_hello_world(root)

    files      = scan_files(root)
    open_file  = files[0] if files else None

    console.print(f"\n[bold green] ⚡ Sashi Android Studio v2.0[/bold green]  [dim]{root}[/dim]")
    console.print(f"[dim]  {len(files)} files · adb: {'[green]found[/green]' if adb_cmd() else '[yellow]not found[/yellow]'}[/dim]\n")

    MENU = """[bold]MENU[/bold]
  [cyan]f[/cyan]  browse files        [cyan]v <n>[/cyan]  view file #n
  [cyan]b[/cyan]  build APK           [cyan]t[/cyan]     run tests
  [cyan]d[/cyan]  deploy to phone     [cyan]D[/cyan]     git diff
  [cyan]a[/cyan]  AI assist           [cyan]n[/cyan]     new Kotlin file
  [cyan]e[/cyan]  open in $EDITOR     [cyan]q[/cyan]     quit"""

    console.print(MENU)

    while True:
        try:
            cmd = input("\n[sas]> ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            break

        if not cmd:
            continue
        elif cmd == "q":
            break
        elif cmd == "f":
            files = scan_files(root)
            show_files(root, files)
        elif cmd.startswith("v"):
            parts = cmd.split()
            if len(parts) == 2 and parts[1].isdigit():
                idx = int(parts[1]) - 1
                if 0 <= idx < len(files):
                    open_file = files[idx]
                    view_file(open_file, root)
                else:
                    console.print("[red]Invalid file number[/red]")
            else:
                console.print("[dim]Usage: v <number>  e.g. v 3[/dim]")
        elif cmd == "b":
            do_build(root)
        elif cmd == "t":
            do_test(root)
        elif cmd == "d":
            do_deploy(root)
        elif cmd == "D":
            do_diff(root, open_file)
        elif cmd == "a":
            do_ai(open_file)
        elif cmd == "n":
            do_new_file(root)
            files = scan_files(root)
        elif cmd == "e":
            if open_file:
                editor = os.environ.get("EDITOR", "nano")
                subprocess.run([editor, str(open_file)])
            else:
                console.print("[yellow]No file open — use v <n> first[/yellow]")
        elif cmd in ("?", "h", "help"):
            console.print(MENU)
        else:
            console.print(f"[dim]Unknown command '{cmd}' — type ? for help[/dim]")

    console.print("[bold green]Sashi Android Studio closed.[/bold green]")

if __name__ == "__main__":
    main()
