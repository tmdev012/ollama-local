# ── Helpers ───────────────────────────────────────────────────────────────────
def run(args, cwd=None, label=""):
    if label:
        console.print(f"[cyan]▶ {label}[/cyan]")
    proc = subprocess.Popen(
        args, cwd=str(cwd) if cwd else None,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
    )
    for line in proc.stdout:
        console.print(line.rstrip())
    proc.wait()
    ok = proc.returncode == 0
    console.print(f"[{'green' if ok else 'red'}]{'✓ done' if ok else '✗ failed'} (exit {proc.returncode})[/{'green' if ok else 'red'}]")
    return ok

def adb_cmd():
    """Return adb binary path — checks PATH then known install locations."""
    found = shutil.which("adb") or shutil.which("adb.exe")
    if found:
        return found
    candidates = [
        Path.home() / "Android/platform-tools/adb",
        Path("/usr/lib/android-sdk/platform-tools/adb"),
        Path("/opt/android-sdk/platform-tools/adb"),
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    return None

def get_package(root: Path) -> str:
    manifest = root / "app/src/main/AndroidManifest.xml"
    try:
        import re
        m = re.search(r'package="([^"]+)"', manifest.read_text())
        return m.group(1) if m else "com.example.app"
    except Exception:
        return "com.example.app"

# ── File browser ──────────────────────────────────────────────────────────────
def scan_files(root: Path):
    exts = {".kt",".java",".xml",".kts",".toml",".gradle",".md",".json",".sh",".py",".yaml",".yml",".txt"}
    skip = {"build",".gradle",".idea","__pycache__","node_modules",".git"}
    files = []
    for p in sorted(root.rglob("*")):
        if any(s in p.parts for s in skip): continue
        if p.is_file() and p.suffix in exts:
            files.append(p)
    return files

def show_files(root: Path, files):
    tbl = Table(show_header=False, box=box.SIMPLE, padding=(0,1))
    tbl.add_column("n", style="dim", width=4)
    tbl.add_column("file")
    for i, f in enumerate(files, 1):
        rel = f.relative_to(root)
        depth = len(rel.parts) - 1
        pad = "  " * depth
        ext_color = {".kt":"bright_yellow",".xml":"bright_blue",".kts":"orange1",
                     ".md":"green",".toml":"magenta"}.get(f.suffix,"white")
        tbl.add_row(str(i), Text(f"{pad}{f.name}", style=ext_color))
    console.print(Panel(tbl, title=f"[bold]FILES — {root.name}[/bold]", border_style="blue"))

def view_file(f: Path, root: Path):
    ext_map = {".kt":"kotlin",".java":"java",".xml":"xml",".kts":"kotlin",
               ".toml":"toml",".md":"markdown",".sh":"bash",".py":"python",
               ".json":"json",".yaml":"yaml",".yml":"yaml"}
    lang = ext_map.get(f.suffix, "text")
    try:
        syn = Syntax(f.read_text(errors="replace"), lang, theme="monokai",
                     line_numbers=True, word_wrap=False)
        console.print(Panel(syn, title=f"[bold]{f.relative_to(root)}[/bold]", border_style="green"))
    except Exception as e:
        console.print(f"[red]Cannot read file: {e}[/red]")

# ── Build / test ──────────────────────────────────────────────────────────────
def do_build(root: Path):
    run(["./gradlew", "assembleDebug", "--quiet"], cwd=root, label="gradle assembleDebug")

def do_test(root: Path):
    run(["./gradlew", "test", "--quiet"], cwd=root, label="gradle test")

# ── Deploy ────────────────────────────────────────────────────────────────────
def do_deploy(root: Path):
    adb = adb_cmd()
    if not adb:
        console.print("[yellow]adb not found on PATH.[/yellow]")
        console.print("[dim]Install with: sudo apt install adb[/dim]")
        return

    console.print("[dim]Connect options:[/dim]")
    console.print("  [cyan]1[/cyan] USB (already connected)")
    console.print("  [cyan]2[/cyan] Wireless (enter IP)")
    choice = input("Choice [1/2]: ").strip()

    if choice == "2":
        ip = input("Phone IP address (e.g. 192.168.1.42): ").strip()
        if not ip:
            console.print("[red]No IP entered.[/red]"); return
        port = input("Port [default 5555]: ").strip() or "5555"
        console.print(f"[cyan]▶ adb connect {ip}:{port}[/cyan]")
        r = subprocess.run([adb, "connect", f"{ip}:{port}"], capture_output=True, text=True)
        console.print(r.stdout.strip() or r.stderr.strip())

    # Verify device is available
    r = subprocess.run([adb, "devices"], capture_output=True, text=True)
    lines = [l for l in r.stdout.splitlines()[1:] if l.strip() and "device" in l and "offline" not in l]
    if not lines:
        console.print("[red]No device connected.[/red]"); return
    console.print(f"[green]● Device: {lines[0].split()[0]}[/green]")

    # Build then install
    apk = root / "app/build/outputs/apk/debug/app-debug.apk"
    if not apk.exists():
        console.print("[yellow]APK not found — building first...[/yellow]")
        if not run(["./gradlew", "assembleDebug", "--quiet"], cwd=root, label="gradle assembleDebug"):
            return

    pkg = get_package(root)
    if not run([adb, "install", "-r", str(apk)], label="adb install"):
        return
    activity = f"{pkg}/.MainActivity"
    run([adb, "shell", "am", "start", "-n", activity], label=f"launch {pkg}")

# ── AI assist ─────────────────────────────────────────────────────────────────
def do_ai(open_file: Path = None):
    ctx = ""
    if open_file:
        try:
            lines = open_file.read_text(errors="replace").splitlines()[:60]
            ctx = f"File: {open_file.name}\n```\n" + "\n".join(lines) + "\n```\n"
        except Exception:
            pass
    question = input("AI question (Enter for auto-explain): ").strip()
    prompt = ctx + (question or "Explain this code and suggest improvements.")
    console.print("[cyan]▶ Asking fast-sashi...[/cyan]")
    r = subprocess.run(["ollama", "run", "fast-sashi", prompt],
                       capture_output=True, text=True, timeout=120)
    for line in (r.stdout or r.stderr).splitlines():
        console.print(line)

# ── Git diff ──────────────────────────────────────────────────────────────────
def do_diff(root: Path, open_file: Path = None):
    target = ["--", str(open_file)] if open_file else []
    r  = subprocess.run(["git", "diff"]          + target, capture_output=True, text=True, cwd=str(root))
    r2 = subprocess.run(["git", "diff", "--cached"] + target, capture_output=True, text=True, cwd=str(root))
    diff = (r2.stdout + r.stdout).strip() or "(no changes)"
    fname = open_file.name if open_file else "project"
    syn = Syntax(diff, "diff", theme="monokai", line_numbers=True)
    console.print(Panel(syn, title=f"[bold]DIFF — {fname}[/bold]", border_style="magenta"))

