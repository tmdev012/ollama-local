# ── Interactive TUI ───────────────────────────────────────────────────────────
MENU_TEXT = """\
[bold]MENU[/bold]
  [cyan]f[/cyan]  browse files        [cyan]v <n>[/cyan]  view file #n
  [cyan]b[/cyan]  build               [cyan]t[/cyan]     test
  [cyan]d[/cyan]  deploy USB          [cyan]W <ip>[/cyan] deploy WiFi
  [cyan]a[/cyan]  AI assist           [cyan]n[/cyan]     new file
  [cyan]D[/cyan]  git diff            [cyan]o <ide>[/cyan] open in IDE
  [cyan]e[/cyan]  env vars            [cyan]s[/cyan]     scaffold Hello World
  [cyan]q[/cyan]  quit"""

def interactive(root: Path, fw: FW):
    show_status(root, fw)
    files     = scan_files(root)
    open_file = files[0] if files else None
    console.print(MENU_TEXT)

    while True:
        try:
            cmd = input("\n[sas]> ").strip()
        except (EOFError, KeyboardInterrupt):
            break

        if not cmd:
            continue
        parts = cmd.split()
        raw   = parts[0]
        c     = raw.lower()

        if c == "q":
            break
        elif c == "f":
            files = scan_files(root)
            show_files(root, files)
        elif c == "v" and len(parts) == 2 and parts[1].isdigit():
            idx = int(parts[1]) - 1
            if 0 <= idx < len(files):
                open_file = files[idx]
                view_file(open_file, root)
            else:
                console.print("[red]Invalid file number[/red]")
        elif c == "b":
            do_build(root, fw)
        elif c == "t":
            do_test(root, fw)
        elif raw == "D":
            do_diff(root, open_file)
        elif c == "d":
            do_deploy(root, fw, "usb")
        elif c == "w" and len(parts) == 2:
            do_deploy(root, fw, f"wifi:{parts[1]}")
        elif c == "a":
            do_ai(open_file)
        elif c == "n":
            do_new_file(root, fw)
            files = scan_files(root)
        elif c == "o" and len(parts) == 2:
            do_open_ide(root, parts[1])
        elif c == "s":
            do_scaffold(root, fw)
            files = scan_files(root)
        elif c == "e":
            env_list()
        elif c in ("?", "h", "help"):
            console.print(MENU_TEXT)
        else:
            console.print(f"[dim]Unknown '{cmd}' — ? for help[/dim]")

    console.print("[bold green]Sashi Android Studio closed.[/bold green]")

# ── Entry point ───────────────────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser(
        prog="sashi android-studio",
        description="Sashi Android Studio v5.3.0 — Terminal IDE (Kotlin/Flutter/TypeScript)",
    )
    ap.add_argument("project", nargs="?",
                    default=str(Path.home() / "projects/hello-android"),
                    help="Project directory (default: ~/projects/hello-android)")
    ap.add_argument("--framework", "-F", choices=["kotlin","flutter","typescript"],
                    help="Override framework detection")
    ap.add_argument("--build", action="store_true",   help="Build (headless)")
    ap.add_argument("--test",  action="store_true",   help="Run tests (headless)")
    ap.add_argument("--deploy", metavar="TARGET",
                    help="Deploy headless: usb | wifi:<ip>[:<port>]")
    ap.add_argument("--scaffold", action="store_true",
                    help="Scaffold Hello World project if missing")
    ap.add_argument("--new-file", metavar="NAME",     help="Create new source file")
    ap.add_argument("--open-ide", metavar="IDE",
                    help="Open in IDE: code | idea | studio | pycharm | vim")
    ap.add_argument("--env-list",  action="store_true", help="List env vars")
    ap.add_argument("--env-set",   nargs=2, metavar=("KEY","VAL"), help="Set env var")
    ap.add_argument("--env-get",   metavar="KEY",       help="Get env var")
    ap.add_argument("--status",    action="store_true", help="Show project status")
    args = ap.parse_args()

    root = Path(args.project).expanduser().resolve()

    fw = FW(args.framework) if args.framework else detect_framework(root)

    # ── Env operations (no project needed) ───────────────────────────────────
    if args.env_list:
        env_list(); return
    if args.env_set:
        env_set(args.env_set[0], args.env_set[1]); return
    if args.env_get:
        env_get(args.env_get); return

    # ── Scaffold if requested or missing ─────────────────────────────────────
    if args.scaffold or not root.exists():
        do_scaffold(root, fw)
        fw = detect_framework(root)

    # ── Headless operations (exit with build code) ────────────────────────────
    headless = args.build or args.test or args.deploy or \
               args.new_file or args.open_ide or args.status

    if args.status:
        show_status(root, fw); return

    if args.build:
        ok = do_build(root, fw)
        sys.exit(0 if ok else 1)

    if args.test:
        ok = do_test(root, fw)
        sys.exit(0 if ok else 1)

    if args.deploy:
        ok = do_deploy(root, fw, args.deploy)
        sys.exit(0 if ok else 1)

    if args.new_file:
        do_new_file(root, fw, args.new_file); return

    if args.open_ide:
        do_open_ide(root, args.open_ide); return

    # ── Interactive mode ──────────────────────────────────────────────────────
    interactive(root, fw)

if __name__ == "__main__":
    main()
