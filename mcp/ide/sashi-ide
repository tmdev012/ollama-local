# ── New source file ────────────────────────────────────────────────────────────
def do_new_file(root: Path, fw: FW, name: str = ""):
    if not name:
        name = input("New file name (class/component): ").strip()
    if not name:
        return

    if fw == FW.FLUTTER:
        if not name.endswith(".dart"):
            name = name.lower().replace(" ", "_") + ".dart"
        target = root / "lib" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        cls = "".join(w.capitalize() for w in name[:-5].split("_"))
        target.write_text(f"""\
import 'package:flutter/material.dart';

class {cls} extends StatelessWidget {{
  const {cls}({{super.key}});

  @override
  Widget build(BuildContext context) {{
    return const Center(child: Text('Hello from {cls}'));
  }}
}}
""")
        console.print(f"[green]✓ Created lib/{name}[/green]")

    elif fw == FW.RN:
        if not name.endswith(".tsx"):
            name = name[0].upper() + name[1:] + ".tsx"
        target = root / name
        cls    = name[:-4]
        target.write_text(f"""\
import React from 'react';
import {{View, Text, StyleSheet}} from 'react-native';

const {cls}: React.FC = () => (
  <View style={{styles.container}}>
    <Text>Hello from {cls}</Text>
  </View>
);

const styles = StyleSheet.create({{
  container: {{flex: 1, alignItems: 'center', justifyContent: 'center'}},
}});

export default {cls};
""")
        console.print(f"[green]✓ Created {name}[/green]")

    else:
        if name[0].islower():
            name = name[0].upper() + name[1:]
        if name.endswith(".kt"):
            name = name[:-3]
        pkg    = get_package(root)
        target = root / f"app/src/main/kotlin/{pkg.replace('.','/')}/{name}.kt"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(f"""\
package {pkg}

import android.os.Bundle
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity

class {name} : AppCompatActivity() {{
    override fun onCreate(savedInstanceState: Bundle?) {{
        super.onCreate(savedInstanceState)
        val tv = TextView(this).apply {{
            text = "Hello from {name}"
            textSize = 18f
            setPadding(64, 120, 64, 0)
        }}
        setContentView(tv)
    }}
}}
""")
        console.print(f"[green]✓ Created {target.relative_to(root)}[/green]")

